<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>GameplayEffects.GodotAdapter.Tests</RootNamespace>
    <AssemblyName>GameplayEffects.Godot.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      No LangVersion override, unlike the core tests. The addon's shared/ sources are compiled into
      this project, and the repository root pins C# 9 with nullable warnings as errors: building
      them here is what keeps that layer portable and engine-free, so the tests are written to the
      same level rather than relaxing it.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine-free half of the addon, compiled without Godot. A test asserts that none of these
      files reaches for the engine, which is what makes this possible at all.
    -->
    <Compile Include="..\..\godot\GameplayEffects.Demo\addons\gameplay_effects\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameplayEffects.Core\GameplayEffects.Core.csproj" />
  </ItemGroup>

</Project>
