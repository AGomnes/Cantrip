<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cantrip-realtime</AssemblyName>
    <RootNamespace>Cantrip.Realtime</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The content ships beside the binary, as docs/csharp.md says to. One copy, linked. -->
    <None Include="../content/**/*.cantrip" Link="content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cantrip.Core\Cantrip.Core.csproj" />
  </ItemGroup>

</Project>
