# Emberline's tests.
#
# Every one says `realtime 20` first, because the clock has to be a tick clock before anything
# with a second in it is registered -- a `hero`'s abilities included. `tick N` is the only way
# time passes: there is no `end turn` anywhere below, and that is the point.
#
# `cast` still fails a test when an ability is refused, so what a keeper may *not* do yet is
# asked rather than attempted: `leader.is_ready(Bulwark)` is whether its cooldown has run out and
# `leader.can_use("Ember Bolt")` also asks whether anything is in reach. In a game whose whole
# design is what you may not do yet, those two are half the test surface. FINDINGS #8.
#
# Nothing places an enemy here: a spawn raises `created` and each enemy stands itself at the back
# of the board, so a test only picks the lane.
#
#   dotnet cantrip test realtime/content

# --- the clock is the game --------------------------------------------------------------------

test "a hollow closes a rank every two seconds"
  realtime 20
  enemy Hollow
  arrive enemy 1
  expect enemy.rank == 3
  tick 40
  expect enemy.rank == 2
  tick 40
  expect enemy.rank == 1
  tick 40
  expect enemy.rank == 0

test "and swings at somebody once it is on the line"
  realtime 20
  hero Warden
  enemy Hollow
  arrive enemy 1
  expect leader.hp + Warden.hp == 80 + 34
  tick 120
  expect enemy.rank == 0
  expect leader.hp + Warden.hp == 80 + 34
  tick 40
  expect leader.hp + Warden.hp == 80 + 34 - 5

test "a wisp never closes and throws from where it stands"
  realtime 20
  enemy Wisp
  arrive enemy 1
  tick 60
  expect enemy.rank == 3
  expect leader.hp == 77
  tick 60
  expect leader.hp == 74

test "a breaker hits harder once it is halfway down"
  realtime 20
  enemy Breaker
  arrive enemy 1
  tick 180
  expect enemy.rank == 0
  deal 21 to enemy
  expect enemy.hp == 19
  tick 60
  expect leader.hp == 80 - 9 - 4

# --- what the player does with the seconds ------------------------------------------------------

test "Ember Bolt reaches the far end of the line and waits one second"
  realtime 20
  hold leader 1
  enemy Hollow
  arrive enemy 0
  grant "Ember Bolt"
  expect distance(leader, enemy) == 5
  cast "Ember Bolt"
  expect enemy.hp == 11
  tick 20
  cast "Ember Bolt"
  expect enemy.hp == 6

test "Backdraft reaches two ranks and no further"
  realtime 20
  hold leader 1
  enemy Hollow
  arrive enemy 1
  grant "Backdraft"
  # Said head on: it is off cooldown and still cannot be used, because four ranks out is out of
  # reach. Before `can_use` this had to be written inside out -- two enemies, one reachable and
  # one not, cast at nobody, then see which one it picked.
  expect distance(leader, enemy) == 4
  expect leader.is_ready(Backdraft)
  expect not leader.can_use(Backdraft)
  enemy.rank = 1
  expect distance(leader, enemy) == 2
  expect leader.can_use(Backdraft)
  cast "Backdraft"
  expect enemy.hp == 9

test "Backdraft catches the lane beside the one it lands in"
  realtime 20
  hold leader 1
  enemy Hollow
  enemy Hollow
  arrive enemy1 1
  arrive enemy2 2
  grant "Backdraft"
  tick 80
  cast "Backdraft" on enemy1
  expect enemy1.hp == 9
  expect enemy2.hp == 9

test "Backdraft leaves what it hit burning for three seconds"
  realtime 20
  hold leader 1
  enemy Hollow
  arrive enemy 1
  grant "Backdraft"
  tick 80
  cast "Backdraft"
  expect enemy.Scorched == 2
  expect enemy.hp == 9
  tick 20
  expect enemy.hp == 7
  tick 20
  expect enemy.hp == 5
  tick 20
  expect enemy.hp == 3
  tick 60
  expect enemy.hp == 3
  expect not enemy.has(Scorched)

test "Bulwark covers the whole party for three seconds and then stops"
  realtime 20
  hero Warden
  hero Lantern
  cast Bulwark by Warden
  expect Warden.has(Braced)
  expect Lantern.has(Braced)
  expect leader.has(Braced)
  deal 5 to Lantern
  expect Lantern.hp == 26 - 2
  tick 60
  expect not Lantern.has(Braced)
  deal 5 to Lantern
  expect Lantern.hp == 26 - 2 - 5

test "Haul buys four seconds back from a hollow on the line"
  realtime 20
  hero Warden
  hold Warden 1
  enemy Hollow
  arrive enemy 1
  tick 120
  expect enemy.rank == 0
  cast Haul by Warden on enemy
  expect enemy.rank == 1
  expect enemy.has(Reeling)
  tick 40
  expect enemy.rank == 1
  tick 40
  expect enemy.rank == 0

test "a Signal Flare lands its fire two seconds later, on what is standing there then"
  realtime 20
  hero Lantern
  hold Lantern 1
  enemy Breaker
  arrive enemy 1
  cast "Signal Flare" by Lantern on enemy
  expect enemy.has(Lit)
  expect enemy.hp == 40
  tick 20
  expect enemy.hp == 40
  tick 20
  expect enemy.hp == 40 - 9 - 3

test "and cannot reach the far lane from where the Lantern stands"
  realtime 20
  hero Lantern
  hold Lantern 2
  enemy Hollow
  arrive enemy 0
  expect distance(Lantern, enemy) == 6
  expect not Lantern.can_use("Signal Flare")
  arrive enemy 2
  expect distance(Lantern, enemy) == 4
  expect Lantern.can_use("Signal Flare")
  cast "Signal Flare" by Lantern
  expect enemy.has(Lit)

test "Mend keeps a keeper up"
  realtime 20
  hero Lantern
  hero Warden
  deal 20 to Warden
  expect Warden.hp == 14
  cast Mend by Lantern on Warden
  expect Warden.hp == 24

# --- cooldowns compete for the same second -------------------------------------------------------

test "four abilities fired in one second come back at four different moments"
  realtime 20
  hero Warden
  hero Lantern
  hold leader 1
  hold Warden 0
  hold Lantern 2
  enemy Breaker
  arrive enemy 1
  grant "Ember Bolt"
  cast "Ember Bolt"
  cast Bulwark by Warden
  cast "Signal Flare" by Lantern on enemy
  # One second on, the bolt alone is back.
  tick 20
  cast "Ember Bolt"
  # Three seconds on, the Flare's fire has landed; Bulwark is still waiting.
  tick 40
  expect enemy.hp == 40 - 5 - (5 + 3) - (9 + 3)   # Lit adds 3 to everything after it lands
  expect not Warden.has(Braced)
  # Six seconds in, Bulwark comes back.
  tick 60
  cast Bulwark by Warden
  expect Warden.has(Braced)

# --- what a save has to carry ---------------------------------------------------------------

test "a burn part way through a second is part way through a second"
  realtime 20
  hold leader 1
  enemy Hollow
  arrive enemy 1
  grant "Backdraft"
  tick 80
  cast "Backdraft"
  tick 30
  expect enemy.Scorched == 2
  expect enemy.hp == 7

# --- what a keeper may not do yet ----------------------------------------------------------------

test "an ability that is still cooling says so"
  realtime 20
  hero Warden
  expect Warden.is_ready(Bulwark)
  cast Bulwark by Warden
  expect not Warden.is_ready(Bulwark)
  tick 100
  expect not Warden.is_ready(Bulwark)
  tick 20
  expect Warden.is_ready(Bulwark)

test "and one with nobody on the board says so separately"
  realtime 20
  hero Lantern
  hold Lantern 2
  # Ready from the first tick, and still not usable: there is nobody to aim it at. Those are two
  # different answers and a real-time game says different things about them.
  expect Lantern.is_ready("Signal Flare")
  expect not Lantern.can_use("Signal Flare")
  enemy Hollow
  arrive enemy 2
  expect Lantern.is_ready("Signal Flare")
  expect Lantern.can_use("Signal Flare")

# --- the fight is over when the game says it is ---------------------------------------------------

test "an empty board does not win the fight"
  realtime 20
  hold leader 1
  enemy Hollow
  arrive enemy 1
  grant "Ember Bolt"
  apply Braced 1 for 30s to leader
  cast "Ember Bolt"
  tick 20
  cast "Ember Bolt"
  tick 20
  cast "Ember Bolt"
  tick 20
  cast "Ember Bolt"
  # The Hollow is gone and the board is empty, and under `ends: called` that is all it is: the
  # hold runs on the clock, not on the body count, and the next wave is still two seconds away.
  # A battle that had ended would have stripped Braced on its way out, and this one has not.
  expect count(enemies) == 0
  expect leader.has(Braced)
  expect leader.hp == 80
