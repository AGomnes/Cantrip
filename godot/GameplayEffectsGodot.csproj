<Project Sdk="Godot.NET.Sdk/4.6.1">

  <!--
    Godot 4.6 .NET builds with net8.0: GodotSharp 4.6.1 ships lib/net8.0 only. The SDK declares
    Debug, ExportDebug and ExportRelease; only Debug defines TOOLS and references GodotSharpEditor,
    which is why every editor-only type in addons/ sits behind #if TOOLS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GameplayEffects.GodotAdapter</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      In this repository the rules engine is a project next door. A game that installs the addon
      replaces this with a PackageReference or a DLL in the project. The configuration is pinned:
      MSBuild would otherwise ask the library for an ExportRelease build it does not define.
    -->
    <ProjectReference Include="..\src\GameplayEffects.Core\GameplayEffects.Core.csproj" SetConfiguration="Configuration=Release" />
  </ItemGroup>

</Project>
