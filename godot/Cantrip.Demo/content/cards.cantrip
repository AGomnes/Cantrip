# The demo's cards. Burn lives in statuses.cantrip: names resolve across files, which is why the
# importer reports a file's parse problems but never claims a single file is valid on its own.

card "Ember"
  cost 1
  target enemy
  tags attack, fire
  effect:
    deal 5 to target
    apply Burn 2 to target
  text: "Deal {damage} damage and apply {Burn}."

card "Guard"
  cost 1
  tags skill
  effect:
    block 6

# Needs a decision the rules cannot make alone, which is what exercises the deferred-choice path:
# the action rolls back, the game is asked, and it replays with the answer.
card "Sort"
  cost 0
  tags skill
  effect:
    choose 1 from hand as picked
    exhaust picked
