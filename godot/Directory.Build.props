<Project>

  <!--
    Chain to the repository root so the Godot projects keep its conventions (nullable warnings as
    errors, no implicit usings, package metadata), then relax the one setting that cannot apply.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      C# 9 is pinned at the root only to keep the engine compilable for Unity. Godot's own source
      generators emit modern C# into this compilation, so the Godot projects build at the latest
      language version instead.
    -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
