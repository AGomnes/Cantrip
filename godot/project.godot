; Godot project for the Gameplay Effects adapter: the addon itself, a demo, and headless tests.
;
; The C# assembly must be built before Godot runs, or the plugin silently does not load and the
; [GlobalClass] types are invisible to GDScript:
;
;   dotnet build godot/GameplayEffectsGodot.csproj
;   Godot_v4.6.1-stable_mono_win64_console.exe --headless --path godot --import

config_version=5

[application]

config/name="Gameplay Effects"
config/description="Cards, statuses, relics and abilities written as text files."
config/features=PackedStringArray("4.6", "C#")

[dotnet]

project/assembly_name="GameplayEffectsGodot"

[editor_plugins]

enabled=PackedStringArray("res://addons/gameplay_effects/plugin.cfg")
