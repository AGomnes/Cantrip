<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Cantrip.Sim</RootNamespace>
    <AssemblyName>cantrip-sim</AssemblyName>
    <!-- Built for net9.0 but runs on any later runtime, so a machine with only a newer .NET can use it. -->
    <RollForward>Major</RollForward>
    <Description>Plays whole runs of the slice headlessly with a bot, and reports how they went.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cantrip.Core\Cantrip.Core.csproj" />
  </ItemGroup>

</Project>
