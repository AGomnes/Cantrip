<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Cantrip.Sim</RootNamespace>
    <AssemblyName>Cantrip.Sim</AssemblyName>
    <!-- A library, shipped inside the `cantrip` tool rather than packed or installed on its own. -->
    <IsPackable>false</IsPackable>
    <Description>What `cantrip sim` runs: the scenario runner, its bots and the meter that records what the engine raised.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cantrip.Core\Cantrip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The meter's per-run ledger is checked against the engine's own hp, which is a test's job. -->
    <InternalsVisibleTo Include="Cantrip.Core.Tests" />
  </ItemGroup>

</Project>
