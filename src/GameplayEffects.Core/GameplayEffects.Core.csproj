<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 keeps the door open for Unity as well as Godot/.NET. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>GameplayEffects</RootNamespace>
    <AssemblyName>GameplayEffects.Core</AssemblyName>
    <Description>Engine-agnostic core for the gameplay effects DSL: parser, entities, events, statuses, modifiers and the tree-walking interpreter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameplayEffects.Core.Tests" />
  </ItemGroup>

</Project>
