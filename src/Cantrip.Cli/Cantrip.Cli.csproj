<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Cantrip.Cli</RootNamespace>
    <AssemblyName>cantrip</AssemblyName>
    <!-- Built for net9.0 but runs on any later runtime, so a machine with only a newer .NET can use it. -->
    <RollForward>Major</RollForward>
    <Description>The cantrip command-line tool: validate, lint, test and describe Cantrip content, and try statements in a REPL.</Description>
    <PackageId>Cantrip.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cantrip</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cantrip.Core\Cantrip.Core.csproj" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
