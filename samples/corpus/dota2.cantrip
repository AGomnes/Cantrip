# Coverage corpus: Dota 2 style effects, mostly on the real-time tick clock.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: dota2.tests.cantrip.

# The corpus is one library, so the first board declared here is the one every file in it is
# played on. That one is written out to be exactly the board content gets when it declares none —
# one lane, no floor — so nothing else in the corpus moves. The arena below is the second, and
# only the tests that name it are fought on it.

board "Open ground"
  lanes 1
  ranks unbounded

# A small tactical grid, for the two effects that need real space. `shared` is one grid for
# everybody rather than two mirrored ones, so a rank is the same place whoever is standing on it
# and nothing is measured across a gap; `chebyshev` makes a diagonal step one rather than two.

board Arena
  lanes 5
  ranks 5
  shared
  metric chebyshev
  lane_word "column"
  rank_word "row"

status "Stun"
  tags debuff, control
  on before_move(source:owner):
    cancel

# --- 1. ref Lifesteal: heal for a share of the damage dealt -------------------------------------------------

status "Lifesteal"
  tags buff
  stacking intensity
  on damaged(source:owner):
    heal event.amount * stacks / 100 to owner

# --- 2. ref Venomous Gale: damage every second for a few seconds --------------------------------------------
# The venom carries the ticking, so the ability is the hit plus a debuff that lasts two
# seconds and deals its damage once a second.

status "Venom"
  tags debuff, dot
  on every 1s:
    deal 4 to owner

ability "Poison Sting"
  cooldown 5s
  effect:
    deal 4 to enemies
    apply Venom for 2s to enemies

# --- 3. ref Skull Basher: a chance to stun on hit --------------------------------------------------------------
# Stun cancels its host's move in the before phase, so a stunned unit really does lose its turn.

relic "Skull Basher"
  on damaged(source:owner):
    chance 25%:
      apply Stun 1 for 1s to event.target

enemy "Brute"
  hp 20
  attack 5
  move "Smash":
    deal 5 to player

# --- 4. ref Vladmir's Offering: allies deal more damage ---------------------------------------------------------

relic "War Banner"
  modify damage of allies: x1.25

# --- 5. ref cooldown reduction ------------------------------------------------------------------
# `cooldown` is a modifier channel, so an item can shorten what every ability of its holder waits.
# Written on the ability instead, it would shorten only that one — the division `cost` makes between
# a card and its owner's cards. Modifiers see the cooldown already converted into clock units, so
# `x0.5` means half whether the ability says `4s` or `2 turns`.

ability "Chain Bolt"
  cooldown 4s
  effect:
    deal 3 to enemies

relic "Arcane Vestments"
  modify cooldown: x0.5

# --- 6. ref Crystal Nova: damage in an area ----------------------------------------------------
# Works, for a fight that happens on a board. `range 3` is how far it may be thrown, measured in
# slots from whoever throws it; `within(target, 1)` is the square around where it lands, and `in`
# narrows that to the other side. A blast is not pointed at anybody, so it is not filtered: it
# reaches a stealthed unit and a shielded one, which is the rule these games have.
#
# A game whose fight happens in continuous space writes `within(target, 5m)` instead, with the
# unit, and its own host answers that — unchanged, and the reason both spellings live under one
# word.

ability "Crystal Nova"
  cooldown 8s
  range 3
  target enemy
  effect:
    deal 6 to enemies in within(target, 1)

# --- 7. ref Blink: move somewhere else ---------------------------------------------------------
# Works, in slots. A move is a member write, and it is instantaneous in the rules on both clocks:
# the engine never owns travel time, because the moment it does it owns collision during travel,
# interruption and a movement speed, and that is a pathfinder. A game that wants the unit to walk
# writes `in 1s: owner.rank -2`, or animates it in its own frame loop while the rules have
# already moved it.

ability "Blink"
  cooldown 6s
  effect:
    owner.rank -2

# --- 8. ref Mana regeneration: mana trickles back every second ----------------------------

relic "Mana Font"
  on every 1s:
    gain 1 mana to player
