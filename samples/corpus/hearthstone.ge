# Coverage corpus: Hearthstone style effects.
# Minions are actors on the player's side, summoned by cards or `create`.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: hearthstone.tests.ge.

actor "Footman"
  hp 2
  attack 1

# --- 1. ref Divine Shield: ignore the next damage ----------------------------------------------------

status "Aegis"
  tags buff
  stacking none
  on owner.before_damaged:
    if event.amount > 0:
      cancel
      remove Aegis from owner

# --- 2. ref Leper Gnome: Deathrattle ------------------------------------------------------------------

actor "Plague Gnome"
  hp 1
  attack 1
  on self.died:
    deal 2 to all enemies

# --- 3. ref Elven Archer: Battlecry --------------------------------------------------------------------

actor "Archer"
  hp 1
  attack 1

card "Elven Archer"
  cost 1
  target enemy
  tags minion
  effect:
    create Archer
    deal 1 to target

# --- 4. ref Kobold Geomancer: Spell Damage +1 ------------------------------------------------------------
# Workaround: a modifier written on a minion is anchored to that minion, so "your spells" needs
# an explicit scope and filter.

card "Arcane Shot"
  cost 1
  target enemy
  tags spell
  effect:
    deal 2 to target

actor "Kobold Geomancer"
  hp 2
  attack 2
  modify damage of enemies where tag:spell, source:player: +1

# --- 5. ref Dire Wolf Alpha: adjacent minions have +1 attack ------------------------------------------------

actor "Dire Wolf"
  hp 2
  attack 3
  modify attack of adjacent(self): +1

# --- 6. ref Knife Juggler: after you summon a minion, deal 1 to a random enemy -------------------------------
# Workaround: a listener that becomes active during an event also hears that event, so the
# Juggler has to leave its own summon out. `not target:self` says that as a filter rather than
# as a guard in the body, but it still has to be said.

actor "Knife Juggler"
  hp 2
  attack 2
  on created(kind:actor, not target:self):
    deal 1 to random enemies

# --- 7. ref minion combat: trade attack for attack ----------------------------------------------------------
# Combat is still spelled out in content, which is this library's division of labour, but
# `attack` makes each creature the source of its own hit, so what a minion deals is its own
# damage and its own listeners hear it.

verb trade(minion, victim):
  attack victim with minion
  attack minion with victim

# --- 8. ref Taunt: the other side must attack this minion -----------------------------------------------------
# Target selection has rules content can add to: the `targetable` channel, asked over a base of 1
# before a card accepts a target. While this is attached, the other side's single-target cards can
# only be pointed at something that also has Taunt. The predicate is `not it.has(Taunt)` rather than
# a comparison with the owner, so two taunting minions leave each other available instead of
# cancelling out, and `source:enemies` is what keeps a taunt from constraining its own side. Area
# and random effects are not filtered, which is the rule these games actually have.

status "Taunt"
  stacking none
  modify targetable of allies where source:enemies, not it.has(Taunt): set 0

# --- 9. ref Silence: remove a minion's abilities --------------------------------------------------------------
# Not expressible: nothing can switch off an entity's own listeners and modifiers. Removing a status
# works, but a minion's printed abilities are not statuses.

# --- 10. ref Discover: choose one of three random cards -------------------------------------------------------
# Not expressible: picking random definitions from a pool is gap 7.

# --- 11. ref Stealth: this minion cannot be targeted ----------------------------------------------------------
# The same channel with no scope at all, which anchors to the host like any other modifier. A blast
# still reaches it; only pointing a card at it is refused.

status "Stealth"
  stacking none
  modify targetable: set 0
