# Coverage corpus: Balatro style scoring.
# The player holds three stats: chips, mult and score. Playing a card scores its chips; playing
# "Play Hand" raises hand_scored and adds chips x mult to the score. Jokers are relics.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: balatro.tests.cantrip.

verb score(c):
  gain c.chips chips to player

card "Ace of Hearts"
  cost 0
  chips 11
  tags heart
  effect:
    score card

card "Seven of Diamonds"
  cost 0
  chips 7
  tags diamond
  effect:
    score card

card "Seven of Spades"
  cost 0
  chips 7
  tags spade
  effect:
    score card

card "Play Hand"
  cost 0
  effect:
    emit hand_scored
    gain chips * mult score to player

# --- 1. ref Greedy Joker: +3 mult for each diamond scored ------------------------------------------------

relic "Greedy Joker"
  on card_played(tag:diamond):
    gain 3 mult to player

# --- 2. ref Abstract Joker: +3 mult per joker, at scoring time ----------------------------------------------
# Workaround: after listeners resolve once the card has finished, too late for the score on
# the next line, so the joker listens in the before phase, which runs straight away.
# Confirmed by experiment: on the after phase the score comes out 33 instead of 231.

relic "Abstract Joker"
  on before_hand_scored:
    gain 3 * relics.count mult to player

# --- 3. ref Cavendish: x3 mult ---------------------------------------------------------------------------------

relic "Cavendish"
  modify mult: x3

# --- 4. ref Glass Card: x2 mult, and it may break ----------------------------------------------------------------

card "Glass Queen"
  cost 0
  chips 10
  tags glass
  effect:
    score card
    player.mult *= 2
    chance 25%:
      destroy self

# --- 5. ref joker order: the left one applies first ------------------------------------------------------------
# Not expressible: jokers apply left to right, so a xMult joker sitting before a +Mult joker scores
# less than the same pair the other way round. The modifier pipeline resolves by layer — add, then
# multiply, then clamp, then override — and never by the position of the thing that declared it.
# Gap 9, and it wants to be a ruleset option rather than a change to how layers work.

# --- 6. ref Blueprint: copy the joker beside it ----------------------------------------------------------------
# Not expressible: copying another entity's ability needs effects to be values that can be read and
# run. Gap 5, which the design notes already list as a stress test. Silence (hearthstone.cantrip #9) is
# the same gap from the other side: switching an entity's own effects off.

# --- 7. ref poker hands: pairs, flushes and straights ----------------------------------------------------------
# Not expressible: scoring a hand means grouping the cards played — counting by rank, counting by
# suit, finding runs of consecutive values. Nothing here groups a collection by a key or counts
# distinct values; `where` filters and `.count` counts, which is not enough for a flush. Gap 8.
