# Tests for dota2.cantrip. Player: 80 hp, 3 energy, seed 1. `realtime 10` means ten ticks a second.

test "dota Lifesteal heals for a share of the damage dealt"
  player hp 50
  enemy hp 50
  apply Lifesteal 50 to player
  deal 10 to enemy
  expect player.hp == 55

test "dota Poison Sting ticks once a second"
  realtime 10
  enemy hp 30
  grant "Poison Sting"
  cast "Poison Sting"
  expect enemy.hp == 26
  tick 10
  expect enemy.hp == 22
  tick 10
  expect enemy.hp == 18
  tick 10
  expect enemy.hp == 18

test "dota Skull Basher sometimes stuns"
  realtime 10
  enemy hp 100
  relic "Skull Basher"
  repeat 12:
    deal 1 to enemy
  expect enemy.has(Stun)

test "dota a stunned unit loses its move"
  enemy Brute
  end turn
  expect player.hp == 75
  apply Stun 1 to enemy
  end turn
  expect player.hp == 75

test "dota War Banner boosts allied damage only"
  enemy Raider
  relic "War Banner"
  deal 20 to enemy
  expect enemy.hp == 5
  end turn
  expect player.hp == 76

test "dota Mana Font regenerates mana once a second"
  # `realtime 10` comes first on purpose: the clock has to be the tick clock before the relic
  # is granted, or the `1s` interval means nothing to it and no periodic listener registers.
  realtime 10
  player mana 0
  relic "Mana Font"
  tick 10
  expect player.mana == 1
  tick 20
  expect player.mana == 3

# Four seconds halved is twenty ticks. `is_ready` says it head on: still waiting at nineteen ticks,
# back at twenty, where a full four-second cooldown would have nineteen more to go.
test "dota Arcane Vestments halves what an ability waits"
  realtime 10
  enemy hp 30
  relic "Arcane Vestments"
  grant "Chain Bolt"
  cast "Chain Bolt"
  expect enemy.hp == 27
  tick 19
  expect not player.is_ready("Chain Bolt")
  tick 1
  expect player.is_ready("Chain Bolt")
  cast "Chain Bolt"
  expect enemy.hp == 24

# --- 6 and 7: a fight with space in it -----------------------------------------------------------

test "dota Crystal Nova hits the square around where it lands"
  board Arena
  realtime 10
  player hp 60 lane 0 rank 0
  enemy hp 30 lane 1 rank 1
  enemy hp 30 lane 2 rank 2
  enemy hp 30 lane 4 rank 4
  grant "Crystal Nova"
  cast "Crystal Nova" on enemy1
  expect enemy1.hp == 24
  expect enemy2.hp == 24
  expect enemy3.hp == 30

# `range 3` is measured from the caster, so the one in the far corner cannot be nova'd at all and
# the cast goes at the only one it can reach. A reach rule narrows what may be pointed at; it
# never makes the ability fail while there is somebody legal left.
test "dota Crystal Nova cannot be thrown further than its range"
  board Arena
  realtime 10
  player hp 60 lane 0 rank 0
  enemy hp 30 lane 4 rank 4
  enemy hp 30 lane 1 rank 0
  expect distance(player, enemy1) == 4
  expect distance(player, enemy2) == 1
  grant "Crystal Nova"
  cast "Crystal Nova"
  expect enemy1.hp == 30
  expect enemy2.hp == 24

test "dota Blink carries a unit two rows forward"
  board Arena
  realtime 10
  player hp 60 lane 2 rank 4
  enemy hp 30 lane 2 rank 0
  expect distance(player, enemy1) == 4
  grant Blink
  cast Blink
  expect player.rank == 2
  expect distance(player, enemy1) == 2
