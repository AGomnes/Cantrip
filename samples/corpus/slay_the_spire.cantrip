# Coverage corpus: Slay the Spire style effects (cards, relics, statuses, enemy behaviour).
# Names are our own; the "ref" comment names the mechanic being reproduced.
# Classification and notes for every effect live in docs/coverage.md.
# Tests: slay_the_spire.tests.cantrip.   Run:  cantrip test samples/corpus

# --- Shared statuses ---------------------------------------------------------------------

status "Strength"
  tags buff
  stacking intensity
  modify damage: +stacks

status "Dexterity"
  tags buff
  stacking intensity
  modify block: +stacks

status "Vulnerable"
  tags debuff
  stacking duration
  modify damage_taken: x1.5

status "Poison"
  tags dot, poison, debuff
  stacking intensity
  on turn_end:
    deal stacks to owner, ignore block
    stacks -1

# --- Basic cards used by the tests -------------------------------------------------------

card "Swipe"
  cost 1
  target enemy
  tags attack
  effect:
    deal 6 to target

card "Jab"
  cost 0
  target enemy
  tags attack
  effect:
    deal 1 to target

card "Guard"
  cost 1
  tags skill
  effect:
    block 5

# --- 1. ref Bash: damage plus a debuff ----------------------------------------------------

card "Crushing Blow"
  cost 2
  target enemy
  tags attack
  effect:
    deal 8 to target
    apply Vulnerable 2 to target

# --- 2. ref Whirlwind: X-cost, hits every enemy X times ------------------------------------

card "Cyclone"
  cost x
  tags attack
  effect:
    repeat x:
      deal 5 to all enemies

# --- 3. ref Body Slam: damage equal to current block -------------------------------------

card "Shield Slam"
  cost 1
  target enemy
  tags attack
  effect:
    deal block to target

# --- 4. ref Heavy Blade: Strength counts three times -------------------------------------
# Workaround: the Strength modifier already adds 1x; the other 2x is written by hand.
# Confirmed by experiment: writing 3x deals 26 rather than 23, because the modifier applies its
# own multiple on top of whatever the effect says.

card "Titan Blade"
  cost 2
  target enemy
  tags attack
  effect:
    deal 14 + 2 * player.Strength to target

# --- 5. ref Demon Form: power that grows Strength every turn -----------------------------

card "Fiend Form"
  cost 3
  tags power
  on turn_start:
    gain 2 Strength

# --- 6. ref Blade Dance: create temporary cards -------------------------------------------

card "Shiv"
  cost 0
  target enemy
  tags attack, exhaust
  effect:
    deal 4 to target

card "Knife Flurry"
  cost 1
  tags skill
  effect:
    create Shiv 3 into hand

# --- 7. ref Accuracy: buff one named card ---------------------------------------------------
# A modifier with no scope is anchored to whatever it is written on, and for a card that means
# the card's own damage. Naming a scope reaches past that, so the power carries the modifier
# itself and needs no status to hold it.

card "Honed Edge"
  cost 1
  tags power
  modify damage of enemies where card:Shiv: +4

# --- 8. ref Corruption: skills cost 0 and exhaust -----------------------------------------

card "Rot Pact"
  cost 3
  tags power
  modify cost of cards where tag:skill: =0
  on card_played(tag:skill):
    exhaust event.card

# --- 9. ref Barricade: block is not removed at turn start -----------------------------------
# The reset says outright that it is a reset, so this refuses that and nothing else. An effect
# that means to strip block still strips it.

card "Bastion"
  cost 3
  tags power
  on before_block_changed(target:owner):
    if event.reset: cancel

# --- 10. ref Burst: the next skill this turn is played twice ------------------------------
# Workaround: the status is applied while Reverb is resolving, and a listener that becomes
# active during an event also hears that event's after phase, so without the card:Reverb
# guard Reverb would replay itself.

card "Reverb"
  cost 1
  tags skill, exhaust
  effect:
    apply Echo 1

status "Echo"
  tags buff
  stacking intensity
  decay 1
  on card_played(tag:skill, not card:Reverb):
    replay event.card on event.target
    stacks -1

# --- 11. ref Reaper: heal for the unblocked damage dealt -----------------------------------
# `into` binds what the attack actually landed — past block, and only what a dying enemy could
# still take — so the card simply heals that.

card "Soul Reap"
  cost 2
  tags attack, exhaust
  effect:
    deal 4 to all enemies into dealt
    heal dealt

# --- 12. ref Envenom: unblocked attack damage poisons -------------------------------------

card "Venom Coat"
  cost 2
  tags power
  effect:
    apply Envenomed 1

status "Envenomed"
  tags buff
  on damaged(source:owner, tag:attack):
    if event.amount > 0: apply Poison stacks to event.target

# --- 13. ref Pain: a curse that hurts while it sits in hand -------------------------------

card "Ache"
  cost 0
  tags curse, unplayable
  on card_played:
    lose 1 hp

# --- 14. ref Pen Nib: every tenth attack deals double -----------------------------------

relic "Quill Nib"
  counter 0
  modify damage where tag:attack, counter == 9: x2
  on card_played(tag:attack):
    counter +1
    if counter >= 10: counter = 0

# --- 15. ref Anchor: start each combat with block -----------------------------------------
# Workaround: block granted on battle_start is wiped by the first turn_start reset, so the
# relic grants it on the first turn_start instead (see "Naive Anchor" test).

relic "Heavy Anchor"
  on turn_start once per battle:
    block 10

relic "Naive Anchor"
  on battle_start:
    block 10

# --- 16. ref Snecko Eye: randomise the cost of drawn cards --------------------------------

relic "Serpent Eye"
  on drawn:
    event.target.cost = 0..3

# --- 17. ref Artifact: negate the next debuff --------------------------------------------
# Status names with hyphens or spaces can only be written as strings, so this one is a
# single word.

status "Nullify"
  tags buff
  stacking intensity
  on before_owner.status_applied(tag:debuff):
    cancel
    stacks -1

# --- 18. ref Intangible: all damage taken is reduced to 1 --------------------------------

status "Phased"
  tags buff
  stacking duration
  modify damage_taken: clamp 1

# --- 19. ref Cultist: opening move, then the same move forever; Ritual ------------------
# Phases give the opening its own move, so the intent the player is shown is the real one
# rather than a single "Act" hiding a branch. Ritual still skips the turn it was applied on
# with a counter stat, which is cross-turn state rather than a temporary.

enemy "Chanter"
  hp 50
  phase Opening when not self.has(Ritual)
  phase Onward when self.has(Ritual)
  move "Chant" phase Opening:
    apply Ritual 3 to self
  move "Slash" phase Onward:
    deal 6 to player

status "Ritual"
  tags buff
  stacking intensity
  fresh 1
  on turn_end:
    if fresh == 1:
      fresh = 0
    else:
      gain stacks Strength

# --- 20. ref Louse Curl Up: block the first time it is hit --------------------------------

enemy "Rolling Louse"
  hp 12
  on self.damaged(tag:attack) once per battle:
    block 5
  move "Bite":
    deal 5 to player

# --- 21. ref Gremlin Nob Enrage: grows when the player uses skills -----------------------

status "Fury"
  tags buff
  stacking intensity
  on card_played(tag:skill):
    gain stacks Strength

# --- 22. ref Slime Boss: split into two when at half hp ---------------------------------
# A phase gates the Split, and `retelegraph` re-rolls the intent the moment the threshold is
# crossed, so the player is shown the Split before it happens rather than after.

enemy "Slime King"
  hp 40
  phase Whole when hp > max_hp / 2
  phase Broken when hp <= max_hp / 2, retelegraph
  move "Slam" phase Whole:
    deal 8 to player
  move "Split" phase Broken:
    create Slimeling 2
    created.max_hp = self.hp
    created.hp = self.hp
    kill self

enemy "Slimeling"
  hp 20
  move "Spit":
    deal 3 to player

# --- 23. ref Spore Cloud: debuff the player on death -------------------------------------

enemy "Sporeling"
  hp 10
  on self.died:
    apply Vulnerable 2 to player
