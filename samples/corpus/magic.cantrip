# Coverage corpus: Magic style effects. Creatures are actors on the player's side, spells are
# cards, and permanents that simply sit there are relics.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: magic.tests.cantrip.

# --- 1. ref Lightning Bolt: direct damage ---------------------------------------------------

card "Spark Bolt"
  cost 1
  target enemy
  tags spell, fire
  effect:
    deal 3 to target

# --- 2. ref Raise the Alarm: make two token creatures ---------------------------------------

actor "Militia"
  hp 1
  attack 1
  tags token

card "Muster"
  cost 1
  tags spell
  effect:
    create Militia 2

# --- 3. ref Goblin King: other goblins are bigger -------------------------------------------
# `other` leaves out the entity a modifier is written on, so the chief carries the goblin tag
# itself and still buffs only the rest of them.

actor "Goblin Skirmisher"
  hp 1
  attack 2
  tags goblin

actor "Goblin Chief"
  hp 2
  attack 2
  tags goblin
  modify attack of other allies where tag:goblin: +1

# --- 4. ref Regenerate: survive the first death each turn -----------------------------------

status "Regrowth"
  tags buff
  stacking none
  on instead_of_died(target:owner) once per turn:
    heal 2 to owner

# --- 5. ref Counterspell: counter target spell ----------------------------------------------
# Workaround: a counterspell is an instant held in hand and played into a priority window, and
# there is no priority window here. It becomes a permanent that commits in advance to
# countering the next spell: the spell is still cast and still paid for, and does nothing.

relic "Denial"
  on instead_of_card_played(tag:spell):
    destroy self

# --- 6. ref Blood Artist: every creature death drains the opponents -------------------------

relic "Blood Tithe"
  on killed(kind:actor):
    deal 1 to enemies

# --- 7. ref coloured mana costs -------------------------------------------------------------
# Not expressible: `cost` is one number through one channel, so a cost cannot be "two red and
# one of any colour". Typed, multi-currency costs would need resources the cost channel can
# read, and a payment step content can describe.

# --- 8. ref Flying: only creatures with flying may block it ---------------------------------
# Not expressible: target validity does take rules now — see Taunt in hearthstone.cantrip — but Flying
# decides who may *block* an attacker, and there is no blocking step for a rule to attach to.

# --- 9. ref Deathtouch: any damage it deals is lethal ---------------------------------------

status "Venomstrike"
  tags buff
  stacking none
  on damaged(source:owner):
    kill event.target

# --- 10. ref Lifelink: what it deals, you gain -----------------------------------------------
# A minion controls itself here, so the life goes to `player` rather than to the creature.

status "Soulbond"
  tags buff
  stacking none
  on damaged(source:owner):
    heal event.amount to player
