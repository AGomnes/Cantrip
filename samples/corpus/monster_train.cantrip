# Coverage corpus: Monster Train style effects.
# Units are actors on the player's side; they attack from their own turn_end listeners.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: monster_train.tests.cantrip.

enemy "Raider"
  hp 30
  move "Hack":
    deal 4 to highest position enemies

actor "Train Steward"
  hp 5
  attack 5
  on turn_end:
    deal attack to lowest position enemies

# --- 1. ref Rage: +2 attack per stack, loses a stack each turn -------------------------------------

status "Rage"
  tags buff
  stacking intensity
  decay 1
  modify attack: +2 * stacks

# --- 2. ref Armor: absorbs damage and is used up ------------------------------------------------------

status "Armor"
  tags buff
  stacking intensity
  on owner.before_damaged:
    let absorbed = min(stacks, event.amount)
    event.amount -= absorbed
    stacks -= absorbed

# --- 3. ref Spikes: damages attackers -----------------------------------------------------------------

status "Spikes"
  tags buff
  stacking intensity
  on owner.damaged(source:enemies):
    deal stacks to event.source

# --- 4. ref Multistrike: attacks an extra time --------------------------------------------------------
# Workaround: combat is written in content, so each unit's attack has to read Multistrike itself.

status "Multistrike"
  tags buff
  stacking intensity

actor "Brawler"
  hp 10
  attack 3
  on turn_end:
    repeat 1 + self.Multistrike:
      deal attack to lowest position enemies

# --- 5. ref Slay: triggers when the unit lands a killing blow ----------------------------------------

actor "Headsman"
  hp 8
  attack 10
  on turn_end:
    deal attack to lowest position enemies
  on killed(source:self):
    gain 5 gold to player

# --- 6. ref Revenge: triggers when the unit is damaged -------------------------------------------------

actor "Grudgeholder"
  hp 20
  attack 2
  on self.damaged:
    gain 2 attack

# --- 7. ref Summon: triggers when a unit enters play ----------------------------------------------------

relic "Recruiter's Bell"
  on created(kind:actor):
    gain 1 gold

# --- 8. ref Incant: triggers when a spell is played ------------------------------------------------------

card "Ember Spell"
  cost 0
  tags spell
  effect:
    deal 2 to all enemies

actor "Acolyte"
  hp 6
  attack 1
  on card_played(tag:spell):
    gain 1 attack

# --- 9. ref Burnout: the unit dies after its last turn ----------------------------------------------------

status "Burnout"
  tags debuff
  stacking intensity
  decay 1
  on turn_end:
    if stacks <= 1: kill owner

# --- 10. ref floors and capacity ------------------------------------------------------------------------
# Not expressible: there is one board row per side. Monster Train stacks three floors, each with its own
# capacity, and units move between them — which needs a richer board than a single line of slots, not
# just more slots in the line. Gap 12, the same one Dota 2's area damage and Blink are waiting on.
