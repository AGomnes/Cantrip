# Coverage corpus: Magic style effects. Creatures are actors on the player's side, spells are
# cards, and permanents that simply sit there are relics.
# Names are our own. Classification and notes: docs/coverage.md.   Tests: magic.tests.ge.

# --- 1. ref Lightning Bolt: direct damage ---------------------------------------------------

card "Spark Bolt"
  cost 1
  target enemy
  tags spell, fire
  effect:
    deal 3 to target

# --- 2. ref Raise the Alarm: make two token creatures ---------------------------------------

actor "Militia"
  hp 1
  attack 1
  tags token

card "Muster"
  cost 1
  tags spell
  effect:
    create Militia 2

# --- 3. ref Goblin King: other goblins are bigger -------------------------------------------
# Workaround: a modifier cannot exclude its own owner from its scope, so "other goblins" is
# written by tagging the chief separately and buffing the tag it does not carry.

actor "Goblin Skirmisher"
  hp 1
  attack 2
  tags goblin

actor "Goblin Chief"
  hp 2
  attack 2
  tags goblin_leader
  modify attack of allies where tag:goblin: +1

# --- 4. ref Regenerate: survive the first death each turn -----------------------------------

status "Regrowth"
  tags buff
  stacking none
  on instead_of_died(target:owner) once per turn:
    heal 2 to owner

# --- 5. ref Counterspell: counter target spell ----------------------------------------------
# Workaround: a counterspell is an instant held in hand and played into a priority window, and
# there is no priority window here. It becomes a permanent that commits in advance to
# countering the next spell: the spell is still cast and still paid for, and does nothing.

relic "Denial"
  on instead_of_card_played(tag:spell):
    destroy self

# --- 6. ref Blood Artist: every creature death drains the opponents -------------------------

relic "Blood Tithe"
  on killed(kind:actor):
    deal 1 to enemies

# --- 7. ref coloured mana costs -------------------------------------------------------------
# Not expressible: `cost` is one number through one channel, so a cost cannot be "two red and
# one of any colour". Typed, multi-currency costs would need resources the cost channel can
# read, and a payment step content can describe.

# --- 8. ref Flying: only creatures with flying may block it ---------------------------------
# Not expressible: the same gap as Taunt. There is no blocking step, and target validity has
# no rules content can add to.
