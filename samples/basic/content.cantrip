# Sample content: small examples of the main features, plus the basics needed to run them.
# Load with:  cantrip test samples/basic

# --- Cards -------------------------------------------------------------------------------

card "Strike"
  cost 1
  target enemy
  tags attack
  effect:
    deal 6 to target

card "Defend"
  cost 1
  tags skill
  effect:
    block 5

card "Fireball"
  cost 2
  target enemy
  tags attack, fire
  effect:
    deal 6 to target
    deal 2 to adjacent(target)
    if target.dead: draw 1
  text: "Hurl a ball of flame for {damage} damage. Kill it to draw {draw}."
  flavour: "Warm regards."

card "Flame Jab"
  cost 1
  target enemy
  tags attack, fire
  effect:
    deal 3 to target

card "Shatter"
  cost 1
  target enemy
  tags skill
  effect:
    shatter target

card "Flex"
  cost 0
  tags skill
  effect:
    until turn_end:
      gain 2 Strength

card "Prepare"
  cost 1
  tags skill
  effect:
    next turn:
      draw 2

card "Deadly Poison"
  cost 1
  target enemy
  tags skill
  effect:
    apply Poison 5 to target

# --- Statuses ----------------------------------------------------------------------------

status "Poison"
  tags dot, poison, debuff
  stacking intensity
  on turn_end:
    deal stacks to owner, ignore block
    stacks -1

status "Burn"
  tags dot, fire, debuff
  stacking intensity
  on turn_end:
    deal stacks to owner, ignore block

status "Frozen"
  tags control, ice
  on owner.damaged(tag:fire):
    remove Frozen from owner
    deal 10 to owner

status "Strength"
  tags buff
  stacking intensity
  modify damage: +stacks

status "Vulnerable"
  tags debuff
  stacking duration
  modify damage_taken: x1.5

status "Weak"
  tags debuff
  stacking duration
  modify damage: x0.75

status "Slow"
  tags control, debuff
  stacking intensity

# --- Relics ------------------------------------------------------------------------------

relic "Kindling"
  on status_removed(tag:ice):
    apply Burn 2 to event.target

relic "Pyromancer's Codex"
  modify damage where tag:fire, source:self: x1.5
  modify cost of cards where tag:fire: -1

relic "Echo Chamber"
  on healed(target:owner):
    heal 1

relic "Lizard Tail"
  on instead_of_died(target:owner) once per battle:
    heal 40

# --- Verbs -------------------------------------------------------------------------------

verb shatter(t):
  if t.has(tag:ice):
    remove tag:ice from t
    deal 10 to t

# --- Enemies -----------------------------------------------------------------------------

enemy "Jaw Worm"
  hp 40
  move "Chomp":
    deal 11 to player
  move "Bellow":
    gain 3 Strength
    block 6
  pattern cycle Chomp, Bellow

# --- Real time ---------------------------------------------------------------------------

# The natural spelling is `to enemies within 5m`, but `within` needs a host that knows about
# space (IEffectHost.TryCall), so this headless sample hits every enemy instead.
ability "Frost Nova"
  cooldown 8s
  effect:
    apply Slow 40% for 3s to enemies
