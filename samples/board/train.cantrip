# A fight on a board with more than one row: a Monster Train style train, three floors tall, with
# room for three on each floor. Units are summoned onto the floor whoever summoned them is standing
# on, they hold that floor, and a floor with no room turns a summon away instead of growing.
#
# Everything here is the board and nothing else: the units are plain actors, the cards are plain
# cards, and the only new word in the file is `board`.
#
# Run:  dotnet run --project src/Cantrip.Cli -- test samples/board

ruleset
  clock turns

# --- the board ------------------------------------------------------------------------------
#
# Two axes, both counting from 0: `lane` across and `rank` along the facing axis, where rank 0 is
# the front. `facing` gives each side its own mirrored grid, so rank 0 means "at the front" for
# both of them and no rank ever means the same place on both sides. `gap` is the default and is
# written out here: when someone dies the survivors do not shift, and the hole waits to be filled.
#
# A train calls a lane a floor and a rank a slot, and says so, so its rules text reads like a
# train's. The words change nothing about how anything is measured.

board Train
  lanes 3
  ranks 3
  facing
  metric manhattan
  on_vacated gap
  lane_word "floor"
  rank_word "slot"

# The same fight in a corridor, for the other half of `on_vacated`: one lane, and when someone at
# the front dies everybody behind steps forward. A game picks one board per battle, so declaring
# two costs nothing until one is chosen.

board Corridor
  lanes 1
  ranks 4
  on_vacated close_ranks

# --- the player's units ----------------------------------------------------------------------

# An Imp hits whatever is at the front of the enemy's side. `lowest rank enemies` is the front:
# ranks count from 0, and this is the same selector that has always been there, under the newer
# of its two names.
actor "Imp"
  hp 6
  attack 3
  tags summoned
  on turn_end:
    deal attack to lowest rank enemies

# A Sentinel makes the units beside it hit harder. `adjacent` is one step away on its own side, so
# on this board that is the unit in front of it, the unit behind it, and the units on the floors to
# either side: whatever the board's shape says is one step.
actor "Sentinel"
  hp 12
  attack 2
  tags summoned
  modify attack of adjacent(self): +1
  on turn_end:
    deal attack to lowest rank enemies

card "Summon Imp"
  cost 1
  text: "Summon an Imp on your floor."
  effect:
    create Imp

card "Post a Sentinel"
  cost 2
  text: "Summon a Sentinel on your floor. Units beside it hit for 1 more."
  effect:
    create Sentinel

# Reach written on the card, as a `where` on its own `target` line: `it` is the candidate and ranks
# count from 0, so this reaches the front slot and nothing behind it. On a board three slots deep
# the linter can tell that `it.rank <= 2` would reach everybody and say so; here it cannot.
card "Pike"
  cost 1
  target enemy where it.rank <= 0
  effect:
    deal 6 to target

card "Sweep"
  cost 2
  text: "Deal 3 to every enemy beside the front one."
  effect:
    deal 3 to adjacent(lowest rank enemies)

# --- what is climbing the train ----------------------------------------------------------------

enemy "Crawler"
  hp 8
  attack 4
  move "Gnaw":
    deal attack to player

# A brood mother puts her young on her own floor, and stops when it is full. Nothing in this
# declaration says how many fit: the board does, and a summon that has nowhere to stand is turned
# away: `created` comes back empty and the trace says which floor was full.
enemy "Brood Mother"
  hp 24
  attack 3
  pattern cycle Brood, Lash
  move "Brood":
    create Crawler
  move "Lash":
    deal attack to player

# --- reach, written on the card ------------------------------------------------------------
#
# `range` says how far something may be pointed, in slots, measured by the board. On a `facing`
# board the two sides are mirrored, so across them the slot term is `a + b + 1`: the unit at the
# front of the floor you are standing on is one step away, the one behind it two, and a unit on
# the next floor along one further again. That is what makes `range 1` mean melee without anybody
# writing a number that depends on how deep the train is.
#
# A card's printed reach is its own rule. It is the *base* of the `range` modifier channel, so a
# status can shorten it, but no stranger's modifier writes the card's own `target ... where`.

card "Lunge"
  cost 1
  range 1
  target enemy
  effect:
    deal 6 to target

card "Longbow"
  cost 1
  range 2..3
  target enemy
  effect:
    deal 4 to target

# Everything its holder points at becomes melee, whatever the card printed. The channel computes
# the far end of the reach and the near end follows it down, so a longbow becomes a melee weapon
# rather than something that can no longer reach anything at all.
status "Crippled"
  stacking none
  buff false
  modify range: set 1

# --- moving, which is a member write and not a verb ------------------------------------------
#
# `target.lane += 1` is the whole of "send this unit up a floor". It raises `moved`, it can be
# refused by `before_moved`, it reverts inside `until`, and a step that would leave the board
# stops at the edge of it. A slot somebody else is standing on swaps the two.

# A unit that fights the floor it is standing on, which is the whole of Monster Train in one
# selector: `lowest rank enemies` is the front of the enemy side, and `where it.lane == self.lane`
# narrows it to this unit's own floor. Move the unit and it fights somewhere else.
actor "Gunner"
  hp 7
  attack 4
  tags summoned
  on turn_end:
    deal attack to lowest rank enemies where it.lane == self.lane

card "Post a Gunner"
  cost 2
  text: "Summon a Gunner on your floor. It fires along the floor it stands on."
  effect:
    create Gunner

card "Reassign"
  cost 0
  target ally
  effect:
    target.lane += 1

card "Haul"
  cost 1
  target enemy
  effect:
    target.rank = 0

# `until` puts a place back exactly, because a place is two integers and its inverse is a swap.
# This is where a slot differs from a `transform`, which `until` refuses (CT321) because nothing
# remembers an old form.
card "Lure"
  cost 1
  target enemy
  effect:
    until turn_end:
      target.rank = 0

# There is no permission system and no "immovable" flag: a unit that must not be pushed refuses
# the event, which is knockback immunity written on the day movement ships.
status "Braced"
  stacking none
  on before_moved(target:owner):
    cancel

# --- the shapes an area effect takes ---------------------------------------------------------
#
# Three, and nothing else. `adjacent(x)` is one step from x on x's own side; `lane(x)` is the
# floor x stands on; `within(x, n)` is everything on either side within n steps. Anything else is
# an ordinary `where` over `it.lane` and `it.rank`, which needs no new word.

card "Firebomb"
  cost 2
  target enemy
  effect:
    deal 3 to enemies in within(target, 1)

card "Clear the Floor"
  cost 2
  target enemy
  effect:
    deal 3 to lane(target)

# A move reaches as far as it says, and an enemy whose target has walked out of reach swings at
# whoever it can still get to. That is the same `LegalTargets` a card asks, from the other side.
enemy "Reaver"
  hp 26
  attack 5
  move "Swing" range 1:
    deal attack to target
