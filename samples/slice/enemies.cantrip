# --- Enemies ---------------------------------------------------------------------------------
# Tuned with src/Cantrip.Sim. The greedy bot wins about 64% fighting the elite whenever healthy and about
# 80% when it decides floor 3 by playing out both paths, which it then fights about a fifth of the
# time; the random bot wins about 5%. Damage taken rises floor by floor, and the Archmage gains
# Strength so a long fight punishes a weak deck. Re-run it after changing any number here.

enemy "Cinder Imp"
  hp 24
  move Claw:
    deal 6 to player
  move Ember:
    deal 3 to player
    apply Burn 2 to player
  pattern cycle Claw, Ember

# A creature of frost cannot be chilled, so a frost deck has to find another way through it.
enemy "Frost Wisp"
  hp 16
  immune Chill
  move Touch:
    deal 6 to player
  move Mist:
    block 6
  pattern random_no_repeat

enemy "Tower Guard"
  hp 38
  move Brace:
    block 8
    gain 2 Strength
  move Bash:
    deal 9 to player
  pattern cycle Brace, Bash, Bash

# --- Elite -----------------------------------------------------------------------------------
# Stone does not burn, so a fire deck has to find another way through it.

enemy "Stone Golem"
  hp 50
  immune Burn
  move Harden:
    block 10
  move Slam:
    deal 11 to player
  pattern cycle Harden, Slam, Slam

# --- Boss ------------------------------------------------------------------------------------

enemy Archmage
  hp 120
  phase Calm when hp > max_hp / 2
  phase Unbound when hp <= max_hp / 2, retelegraph
  move Bolt phase Calm:
    deal 11 to player
  move Barrier phase Calm:
    block 12
    gain 2 Strength
  move Meteor phase Unbound:
    deal 16 to player
  move Drain phase Unbound:
    deal 8 to player
    heal 8
