# --- Starter deck ----------------------------------------------------------------------------
# 4 Zap, 4 Ward, Kindle and Rime. The simulator builds the deck; the cards only say what they do.

card Zap
  cost 1
  target enemy
  tags attack, arcane, starter
  effect:
    deal 6 to target

card Ward
  cost 1
  tags skill, starter
  effect:
    block 5

card Kindle
  cost 1
  target enemy
  tags skill, fire, starter
  effect:
    apply Burn 4 to target

card Rime
  cost 1
  target enemy
  tags attack, frost, starter
  effect:
    deal 4 to target
    apply Chill 1 to target

# --- Rewards: fire ---------------------------------------------------------------------------

card Fireball
  cost 2
  target enemy
  tags attack, fire, reward
  effect:
    deal 9 to target
    apply Burn 2 to target

card Scorch
  cost 0
  target enemy
  tags attack, fire, reward
  effect:
    deal 4 to target

card Stoke
  cost 1
  target enemy
  tags skill, fire, reward
  effect:
    let doubled = target.Burn
    apply Burn doubled to target

card "Flame Ward"
  cost 1
  tags skill, fire, reward
  effect:
    block 6
    apply Burn 2 to all enemies

card Inferno
  cost 2
  tags skill, fire, exhaust, reward
  effect:
    apply Burn 5 to all enemies

# --- Rewards: frost --------------------------------------------------------------------------

card Frostbolt
  cost 1
  target enemy
  tags attack, frost, reward
  effect:
    deal 5 to target
    apply Chill 2 to target

card "Cold Snap"
  cost 0
  target enemy
  tags skill, frost, reward
  effect:
    apply Chill 1 to target
    draw 1

card "Glacial Wall"
  cost 2
  tags skill, frost, reward
  effect:
    block 12
    apply Chill 1 to all enemies

card Blizzard
  cost 2
  tags attack, frost, exhaust, reward
  effect:
    deal 5 to all enemies
    apply Chill 2 to all enemies

# --- Rewards: arcane -------------------------------------------------------------------------

card "Mana Surge"
  cost 0
  tags skill, arcane, exhaust, reward
  effect:
    gain 2 energy

card Insight
  cost 1
  tags skill, arcane, reward
  effect:
    draw 2

card "Arcane Missiles"
  cost 1
  tags attack, arcane, reward
  effect:
    repeat 3:
      deal 3 to random 1 enemies

card Spellbook
  cost 1
  tags skill, arcane, exhaust, reward
  effect:
    discover 3 cards where tag:reward as found
    create found into hand
