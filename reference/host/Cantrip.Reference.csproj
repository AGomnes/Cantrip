<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cantrip-reference</AssemblyName>
    <RootNamespace>Cantrip.Reference</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The content ships beside the binary, as docs/csharp.md says to, so the game runs from its
      build folder whatever the working directory. It is linked rather than copied: the one copy
      of it lives in reference/content.
    -->
    <None Include="../content/**/*.cantrip" Link="content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A game outside this repository writes <PackageReference Include="Cantrip.Core" />; in here
      the rules engine is the project next door.
    -->
    <ProjectReference Include="..\..\src\Cantrip.Core\Cantrip.Core.csproj" />
  </ItemGroup>

</Project>
