<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cantrip-reference</AssemblyName>
    <RootNamespace>Cantrip.Reference</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Published two more ways than an ordinary game needs, because docs/stability.md says Cantrip is
    usable from a published game and this is the only game in the repository that can prove it.
    tools/publish-check.sh drives both; docs/stability.md says what each one is worth.

    The switch is a property of this project rather than a `-p:` on the command line, because a
    global property flows into Cantrip.Core, which targets netstandard2.1 and refuses to be
    trimmed (NETSDK1124). Only the application is trimmed; the library it links is trimmed *by*
    it, which is exactly the arrangement a real game has.
  -->
  <PropertyGroup Condition="'$(CantripPublish)' == 'trimmed' or '$(CantripPublish)' == 'aot'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <!-- One warning per offending call site rather than one per assembly: the point is the list. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CantripPublish)' == 'aot'">
    <PublishAot>true</PublishAot>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The content ships beside the binary, as docs/csharp.md says to, so the game runs from its
      build folder whatever the working directory. It is linked rather than copied: the one copy
      of it lives in reference/content.
    -->
    <None Include="../content/**/*.cantrip" Link="content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A game outside this repository writes <PackageReference Include="Cantrip.Core" />; in here
      the rules engine is the project next door.
    -->
    <ProjectReference Include="..\..\src\Cantrip.Core\Cantrip.Core.csproj" />
  </ItemGroup>

</Project>
