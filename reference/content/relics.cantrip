# Relics belong to the leader, which is what makes them the run's: besides hp, the deck and
# Benediction they are the only thing a player carries out of a battle.
#
# Two of them say `of party`, and the comments say why. A relic in a party game is where the
# difference between "the holder" and "the party" bites hardest.

relic "Tideglass"
  on turn_start once per battle:
    block 8 to party

# The run's currency, earned inside a battle and spent outside it. `gold` is a stat on the leader,
# so it is saved and restored with the battle rather than with the game's own run file, which is
# the one piece of the run above the battle that Cantrip does keep for you.
relic "Drowned Coin"
  on killed(target:enemies):
    gain 2 gold

# `of party`, because that is whose damage it is. An `of` group names whoever the value belongs
# to, and on `damage` that is whoever deals it -- the same end the bare form means. The bare form
# would anchor to the holder, and a hero is its own controller, so it would buff the leader's own
# plays and nobody else's.
relic "Choirmaster's Baton"
  modify damage of party where tag:holy: +2
  text: "The party's holy cards deal 2 more damage."

relic "Pilgrim's Token"
  on card_played(tag:holy):
    if event.source.has(tag:devout):
      heal 2 to event.source

# The bare form would shorten the holder's own abilities, and the holder is the leader. `of party`
# is the widening: on `cooldown` the value belongs to whoever is waiting for the ability.
relic "Bell Rope"
  modify cooldown of party: x50%
  text: "Every ability the party uses recharges twice as fast."

relic "Lantern of Ebb"
  on instead_of_died(target:owner) once per run:
    heal 20
